<ui:FluentWindow
  x:Class="ANX.Ui.Views.ShellWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
  Icon="pack://application:,,,/ANX.Ui;component/Assets/anx-icon.png"
  Width="1440"
  Height="900"
  MinWidth="1152"
  MinHeight="720"
  d:DataContext="{d:DesignInstance local:ShellWindow, IsDesignTimeCreatable=False}"
  d:DesignHeight="900"
  d:DesignWidth="1440"
  ExtendsContentIntoTitleBar="True"
  FontFamily="Microsoft YaHei UI, Segoe UI"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowState="Maximized"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      FooterMenuItemsSource="{Binding ViewModel.NavigationFooter, Mode=OneWay}"
      IsBackButtonVisible="Collapsed"
      IsPaneOpen="{Binding ViewModel.IsPaneOpen, Mode=TwoWay}"
      IsPaneToggleVisible="True"
      MenuItemsSource="{Binding ViewModel.NavigationItems, Mode=OneWay}"
      OpenPaneLength="160"
      PaneDisplayMode="Left"
    >
      <ui:NavigationView.Header>
        <ui:BreadcrumbBar Margin="42,28,0,0" FontSize="28" FontWeight="DemiBold" />
      </ui:NavigationView.Header>
    </ui:NavigationView>

    <ui:TitleBar Grid.Row="0" Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}">
      <ui:TitleBar.Icon>
        <!--
          标题栏左侧的品牌图标：16×16（DIP），与 exe 图标同一份资源。
          源图为 64×64，靠 HighQuality 缩放降到 16 DIP，在 100%/125%/150% DPI 下都清晰。
        -->
        <ui:ImageIcon
          Height="16"
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="pack://application:,,,/ANX.Ui;component/Assets/anx-icon.png"
          Width="16"
        />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
  </Grid>
</ui:FluentWindow>
