<Page
  x:Class="ANX.Ui.Views.Pages.SheetSelectionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Sheet"
  d:DataContext="{d:DesignInstance local:SheetSelectionPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部：模式单选 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <RadioButton
        GroupName="SheetMode"
        IsChecked="{Binding ViewModel.IsNewSheet, Mode=TwoWay}"
        Content="{DynamicResource Sheet.New}"
      />
      <RadioButton
        Margin="24,0,0,0"
        GroupName="SheetMode"
        IsChecked="{Binding ViewModel.IsExistingSheet, Mode=TwoWay}"
        Content="{DynamicResource Sheet.Existing}"
      />
    </StackPanel>

    <!-- 中部：随模式切换 -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <ui:Card Padding="20" VerticalContentAlignment="Top"
               Visibility="{Binding ViewModel.IsNewSheet, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource Sheet.New}" />
          <Grid Margin="0,14,0,0" Width="460" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Sheet.Project}" />
            <TextBox Grid.Column="1" Text="{Binding ViewModel.ProjectName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Margin="0,12,0,0"
              Style="{StaticResource FieldLabelStyle}"
              Text="{DynamicResource Sheet.Prefix}"
            />
            <TextBox
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,12,0,0"
              Text="{Binding ViewModel.NumberPrefix, UpdateSourceTrigger=PropertyChanged}"
            />
          </Grid>
        </StackPanel>
      </ui:Card>

      <ui:Card Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
               Visibility="{Binding ViewModel.IsExistingSheet, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource Sheet.Existing}" />
            <ui:Button
              Margin="16,0,0,0"
              Appearance="Secondary"
              Command="{Binding ViewModel.LoadExistingCommand}"
              Content="{DynamicResource Sheet.LoadExisting}"
            />
          </StackPanel>
          <DataGrid
            Margin="0,12,0,0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding ViewModel.ExistingSheets}"
            SelectedItem="{Binding ViewModel.SelectedExisting, Mode=TwoWay}"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding SheetId}" Header="{DynamicResource History.ColSheetId}" />
              <DataGridTextColumn Binding="{Binding ProjectName}" Header="{DynamicResource History.ColProject}" />
              <DataGridTextColumn Binding="{Binding CreatedOn}" Header="{DynamicResource History.ColDate}" />
              <DataGridTextColumn Binding="{Binding SampleCount}" Header="{DynamicResource History.ColSamples}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </ui:Card>
    </Grid>

    <!-- 下部：按钮区 -->
    <StackPanel
      Grid.Row="2"
      Margin="0,16,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
    >
      <ui:Button
        Width="110"
        Appearance="Primary"
        Command="{Binding ViewModel.ConfirmCommand}"
        Content="{DynamicResource Sheet.Confirm}"
      />
      <ui:Button
        Width="110"
        Margin="8,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.CancelCommand}"
        Content="{DynamicResource Sheet.Cancel}"
      />
    </StackPanel>

    <TextBlock
      Grid.Row="3"
      Margin="0,10,0,0"
      Style="{StaticResource MonoTextStyle}"
      Text="{Binding ViewModel.Status, Mode=OneWay}"
    />
  </Grid>
</Page>
