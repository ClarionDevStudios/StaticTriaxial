<Page
  x:Class="ANX.Ui.Views.Pages.HistoryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="History"
  d:DataContext="{d:DesignInstance local:HistoryPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 检索条 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource History.Keyword}" />
      <TextBox
        Width="220"
        Margin="8,0,0,0"
        Text="{Binding ViewModel.Keyword, UpdateSourceTrigger=PropertyChanged}"
      />
      <ui:Button
        Margin="8,0,0,0"
        Appearance="Primary"
        Command="{Binding ViewModel.SearchCommand}"
        Content="{DynamicResource History.Query}"
      />
      <ui:Button
        Margin="16,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.ExportCommand}"
        Content="{DynamicResource History.Export}"
      />
      <ui:Button
        Margin="8,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.ExportEnglishCommand}"
        Content="{DynamicResource History.ExportEn}"
      />
    </StackPanel>

    <!-- 三栏：试验单（主）/ 曲线 / 试件（从）+ 字段表 -->
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DataGrid
          AutoGenerateColumns="False"
          IsReadOnly="True"
          ItemsSource="{Binding ViewModel.Sheets}"
          SelectedItem="{Binding ViewModel.SelectedSheet, Mode=TwoWay}"
          VerticalAlignment="Stretch"
        >
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding SheetId}" Header="{DynamicResource History.ColSheetId}" />
            <DataGridTextColumn Binding="{Binding ProjectName}" Header="{DynamicResource History.ColProject}" />
            <DataGridTextColumn Binding="{Binding CreatedOn}" Header="{DynamicResource History.ColDate}" />
            <DataGridTextColumn Binding="{Binding SampleCount}" Header="{DynamicResource History.ColSamples}" />
          </DataGrid.Columns>
        </DataGrid>
      </ui:Card>

      <ui:Card Grid.Column="1" Margin="0,0,8,0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <sp:WpfPlot x:Name="CurvePlot" VerticalAlignment="Stretch" />
      </ui:Card>

      <ui:Card Grid.Column="2" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource FieldLabelStyle}"
            Text="{DynamicResource History.Samples}"
          />
          <ListBox
            MaxHeight="180"
            Margin="0,6,0,0"
            DockPanel.Dock="Top"
            DisplayMemberPath="Title"
            ItemsSource="{Binding ViewModel.Samples}"
            SelectedItem="{Binding ViewModel.SelectedSample, Mode=TwoWay}"
          />
          <TextBlock
            DockPanel.Dock="Top"
            Margin="0,10,0,0"
            Style="{StaticResource FieldLabelStyle}"
            Text="{DynamicResource History.Fields}"
          />
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ViewModel.SelectedSample.Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Key}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MonoTextStyle}" Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </ui:Card>
    </Grid>

    <TextBlock
      Grid.Row="2"
      Margin="0,10,0,0"
      Style="{StaticResource MonoTextStyle}"
      Text="{Binding ViewModel.Status, Mode=OneWay}"
      TextWrapping="Wrap"
    />
  </Grid>
</Page>
