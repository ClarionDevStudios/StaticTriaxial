<Page
  x:Class="ANX.Ui.Views.Pages.TestExecutionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Execution"
  d:DataContext="{d:DesignInstance local:TestExecutionPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ① 顶部按钮条（照现役：标题栏右侧一排按钮） -->
    <StackPanel
      Grid.Row="0"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
    >
      <ui:Button
        Margin="4,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.OpenSheetSelectionCommand}"
        Content="{DynamicResource Exec.NewSheet}"
      />
      <ui:Button
        Margin="4,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.OpenMachineSettingsCommand}"
        Content="{DynamicResource Exec.TestParams}"
      />
      <ui:Button
        Margin="4,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.PrintReportCommand}"
        Content="{DynamicResource Exec.Print}"
      />
      <ui:Button
        Margin="4,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.OpenHistoryCommand}"
        Content="{DynamicResource Exec.History}"
      />
      <ui:Button
        Margin="4,0,0,0"
        Appearance="Secondary"
        Content="{DynamicResource Exec.DataFlow}"
        IsEnabled="False"
        ToolTip="{DynamicResource Exec.ToDo}"
      />
    </StackPanel>

    <!-- ② 实时数据区：指标卡 + 工作台按钮（照现役布局） -->
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <!-- 卡片列按内容取宽（原来是 *，会撑满整行），按钮紧贴其右侧，剩余宽度留给下面的曲线图 -->
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ItemsControl Grid.Column="0" ItemsSource="{Binding ViewModel.Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--
              卡片按内容取宽：每张的宽度由"标签一行 + 数值"里更宽的那个决定，所以标签不会折行、
              数字也放得下；"峰值"那一行无论有没有都用 Hidden 占位，于是七张卡的高度由内容统一决定。
              WrapPanel 让卡片靠左排、窗口变窄时自动换行。
            -->
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card MinWidth="96" Margin="0,0,8,0" Padding="10">
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                  <Run Text="{Binding DisplayName, Mode=OneWay}" />
                  <Run Text=" " />
                  <Run Text="{Binding Unit, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                  Margin="0,4,0,0"
                  Style="{StaticResource MonoTextStyle}"
                  FontSize="22"
                  Text="{Binding Value, Mode=OneWay}"
                />
                <TextBlock
                  Margin="0,2,0,0"
                  Style="{StaticResource FieldLabelStyle}"
                  Text="{Binding PeakText, Mode=OneWay}"
                  Visibility="{Binding ShowPeak, Converter={StaticResource HiddenWhenFalse}}"
                />
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="1" Width="150">
        <ui:Button
          Height="54"
          Appearance="Secondary"
          Content="{DynamicResource Exec.WorktableUp}"
          IsEnabled="{Binding ViewModel.CanJog}"
          LostMouseCapture="OnJogButtonReleased"
          PreviewMouseLeftButtonDown="OnJogUpButtonPressed"
          PreviewMouseLeftButtonUp="OnJogButtonReleased"
        />
        <ui:Button
          Height="54"
          Margin="0,8,0,0"
          Appearance="Secondary"
          Content="{DynamicResource Exec.WorktableDown}"
          IsEnabled="{Binding ViewModel.CanJog}"
          LostMouseCapture="OnJogButtonReleased"
          PreviewMouseLeftButtonDown="OnJogDownButtonPressed"
          PreviewMouseLeftButtonUp="OnJogButtonReleased"
        />
      </StackPanel>
    </Grid>

    <!-- ③ 三栏：左（试样与操作）/ 中（曲线）/ 右（状态与日志） -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <UniformGrid Columns="3">
              <ui:Button
                Margin="0,0,4,0"
                Appearance="Secondary"
                Command="{Binding ViewModel.OpenSampleEditorCommand}"
                Content="{DynamicResource Exec.NewSample}"
              />
              <ui:Button
                Margin="0,0,4,0"
                Appearance="Secondary"
                Command="{Binding ViewModel.OpenSampleEditorCommand}"
                Content="{DynamicResource Exec.EditSample}"
              />
              <ui:Button
                Appearance="Secondary"
                Content="{DynamicResource Exec.DeleteSample}"
                IsEnabled="False"
                ToolTip="{DynamicResource Exec.ToDo}"
              />
            </UniformGrid>

            <TextBlock
              Margin="0,12,0,0"
              Style="{StaticResource FieldLabelStyle}"
              Text="{DynamicResource Exec.SheetId}"
            />
            <TextBlock Style="{StaticResource MonoTextStyle}" Text="{Binding ViewModel.SheetText, Mode=OneWay}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <ui:Button
              Height="64"
              Appearance="Primary"
              Command="{Binding ViewModel.StartOrStopCommand}"
              Content="{DynamicResource Exec.StartOrStop}"
            />
            <ui:Button
              Height="36"
              Margin="0,8,0,0"
              Appearance="Secondary"
              Command="{Binding ViewModel.CompleteSheetCommand}"
              Content="{DynamicResource Exec.CompleteSheet}"
            />
          </StackPanel>

          <TextBlock
            Margin="0,12,0,0"
            Style="{StaticResource FieldLabelStyle}"
            Text="{DynamicResource Exec.SampleHint}"
            TextWrapping="Wrap"
          />
        </DockPanel>
      </ui:Card>

      <ui:Card Grid.Column="1" Margin="0,0,8,0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <sp:WpfPlot x:Name="RealtimePlot" MinHeight="240" VerticalAlignment="Stretch" />
      </ui:Card>

      <ui:Card Grid.Column="2" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource FieldLabelStyle}"
            Text="{Binding ViewModel.PhaseText, Mode=OneWay}"
          />
          <ui:Button
            DockPanel.Dock="Bottom"
            Margin="0,8,0,0"
            Appearance="Secondary"
            Command="{Binding ViewModel.ClearLogCommand}"
            Content="{DynamicResource Exec.ClearInfo}"
          />
          <!--
            DockPanel 的填充项：它会自动占满"就绪"那行下面到"清空信息"按钮上面那块。
            唯一的前提是**本页高度得是有限的** —— 内容宿主按无限高度量内容时，这块"可用空间"
            本身也是无限的，列表就会随条目无限长高、把整页撑高（实测 300 条时页面 739 → 12380）。
            页面高度在 code-behind 里被限制到宿主可见区（见 UpdatePageHeight），
            所以这里不需要再给列表设高度上限：它铺满中间的可见空间，超出部分自己滚动。
          -->
          <ListBox
            Margin="0,8,0,0"
            FontFamily="Consolas, Courier New"
            FontSize="12"
            ItemsSource="{Binding ViewModel.Log}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
          />
        </DockPanel>
      </ui:Card>
    </Grid>

    <!-- ④ 底部状态栏 -->
    <StackPanel
      Grid.Row="3"
      Margin="0,10,0,0"
      Orientation="Horizontal"
    >
      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Exec.Connection}" />
      <TextBlock
        Margin="8,0,0,0"
        Style="{StaticResource MonoTextStyle}"
        Text="{Binding ViewModel.ConnectionText, Mode=OneWay}"
      />
      <ui:Button
        Margin="16,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.ConnectCommand}"
        Content="{DynamicResource Exec.Connect}"
      />
    </StackPanel>
  </Grid>
</Page>
