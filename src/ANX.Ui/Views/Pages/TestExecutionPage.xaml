<Page
  x:Class="ANX.Ui.Views.Pages.TestExecutionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{DynamicResource Nav.Execution}"
  d:DataContext="{d:DesignInstance local:TestExecutionPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- ① 实时数据区：指标卡 + 工作台按钮 + 两组功能按钮（照现役布局） -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <!-- 卡片按内容取宽；工作台按钮紧贴其右；再右是两组功能按钮；剩余宽度留给下面的曲线图 -->
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ItemsControl Grid.Column="0" ItemsSource="{Binding ViewModel.Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--
              卡片按内容取宽：每张的宽度由"标签一行 + 数值"里更宽的那个决定，所以标签不会折行、
              数字也放得下；"峰值"那一行无论有没有都用 Hidden 占位，于是七张卡的高度由内容统一决定。
              WrapPanel 让卡片靠左排、窗口变窄时自动换行。
            -->
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card MinWidth="96" Margin="0,0,8,0" Padding="10">
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                  <Run Text="{Binding DisplayName, Mode=OneWay}" />
                  <Run Text=" " />
                  <Run Text="{Binding Unit, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                  Margin="0,4,0,0"
                  Style="{StaticResource MonoTextStyle}"
                  FontSize="22"
                  MinWidth="{Binding ValueMinWidth}"
                  Text="{Binding Value, Mode=OneWay}"
                />
                <TextBlock
                  Margin="0,2,0,0"
                  Style="{StaticResource FieldLabelStyle}"
                  Text="{Binding PeakText, Mode=OneWay}"
                  Visibility="{Binding ShowPeak, Converter={StaticResource HiddenWhenFalse}}"
                />
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--
        工作台按钮：水平并排、带上下箭头图标，高度撑满本行 ——
        本行高度由指标卡决定，所以按钮高度自然与卡片一致（不写死数值）。
      -->
      <StackPanel
        Grid.Column="1"
        Margin="8,0,0,0"
        Orientation="Horizontal"
        VerticalAlignment="Stretch"
      >
        <ui:Button
          MinWidth="96"
          Appearance="Primary"
          Content="{DynamicResource Exec.WorktableUp}"
          Icon="{ui:SymbolIcon ArrowUp24}"
          IsEnabled="{Binding ViewModel.CanJog}"
          LostMouseCapture="OnJogButtonReleased"
          PreviewMouseLeftButtonDown="OnJogUpButtonPressed"
          PreviewMouseLeftButtonUp="OnJogButtonReleased"
          VerticalAlignment="Stretch"
        />
        <ui:Button
          MinWidth="96"
          Margin="8,0,0,0"
          Appearance="Primary"
          Content="{DynamicResource Exec.WorktableDown}"
          Icon="{ui:SymbolIcon ArrowDown24}"
          IsEnabled="{Binding ViewModel.CanJog}"
          LostMouseCapture="OnJogButtonReleased"
          PreviewMouseLeftButtonDown="OnJogDownButtonPressed"
          PreviewMouseLeftButtonUp="OnJogButtonReleased"
          VerticalAlignment="Stretch"
        />
      </StackPanel>

      <!--
        四个功能按钮，放在工作台按钮右侧：2×2 排布，**四个按钮等宽**
        （用户 2026-10-15："4个按钮的宽度不一致，History 按钮宽度最小，按标字最长的那个统一"）。
        用 UniformGrid 而不是两个 StackPanel：UniformGrid 的所有格子取**所有孩子里最宽的那个**，
        于是四个按钮一样宽；按行填充的顺序正好还是"新建试验 / 打印报表 / 试验参数 / 历史数据"。
      -->
      <UniformGrid
        Grid.Column="2"
        Margin="12,0,0,0"
        Columns="2"
        Rows="2"
        VerticalAlignment="Top"
      >
          <ui:Button
            MinWidth="96"
            Margin="0,0,4,0"
            Appearance="Primary"
            Command="{Binding ViewModel.OpenSheetSelectionCommand}"
            Content="{DynamicResource Exec.NewSheet}"
            Icon="{ui:SymbolIcon Add24}"
          />
          <ui:Button
            MinWidth="96"
            Margin="4,0,0,0"
            Appearance="Primary"
            Command="{Binding ViewModel.PrintReportCommand}"
            Content="{DynamicResource Exec.Print}"
            Icon="{ui:SymbolIcon Print24}"
          />
          <ui:Button
            MinWidth="96"
            Margin="0,6,4,0"
            Appearance="Primary"
            Command="{Binding ViewModel.OpenMachineSettingsCommand}"
            Content="{DynamicResource Exec.TestParams}"
            Icon="{ui:SymbolIcon Settings24}"
          />
          <ui:Button
            MinWidth="96"
            Margin="4,6,0,0"
            Appearance="Primary"
            Command="{Binding ViewModel.OpenHistoryCommand}"
            Content="{DynamicResource Exec.History}"
            Icon="{ui:SymbolIcon History24}"
          />
      </UniformGrid>
    </Grid>

    <!-- ③ 三栏：左（试样与操作）/ 中（曲线）/ 右（状态与日志） -->
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <!-- 左栏留够宽度：三个试样按钮加图标后要放得下「新建试样」四个字（用户 2026-10-12） -->
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <!--
          用显式行高的 Grid（不是 DockPanel）：列表行给 `*`，高度就是"剩下的空间"，
          不会有列表被底部按钮行盖住的问题（用户 2026-10-13 反馈）。
          行序也是用户定的：先单号行、再试样按钮行、中间列表、底部启动/有效性。
        -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- ① 单号行：单号 +（点中列表条目时）该条目对应的试样编号（用户 2026-10-13） -->
          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource FieldLabelStyle}"
              Text="{DynamicResource Exec.SheetId}"
            />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource MonoTextStyle}"
              Text="{Binding ViewModel.SheetDisplayText, Mode=OneWay}"
            />
          </StackPanel>

          <!-- ② 试样按钮行 -->
          <UniformGrid Grid.Row="1" Margin="0,12,0,0" Columns="3">
              <ui:Button
                Margin="0,0,4,0"
                Appearance="Primary"
                Command="{Binding ViewModel.NewSampleCommand}"
                Content="{DynamicResource Exec.NewSample}"
                Icon="{ui:SymbolIcon Add24}"
              />
              <ui:Button
                Margin="0,0,4,0"
                Appearance="Primary"
                Command="{Binding ViewModel.EditSampleCommand}"
                Content="{DynamicResource Exec.EditSample}"
                Icon="{ui:SymbolIcon Edit24}"
              />
              <ui:Button
                Appearance="Primary"
                Command="{Binding ViewModel.DeleteSampleCommand}"
                Content="{DynamicResource Exec.DeleteSample}"
                Icon="{ui:SymbolIcon Delete24}"
              />
          </UniformGrid>

          <!-- 启动/停止 与 有效性计算 并排一行；启动按钮的文字与图标随运行状态切换（用户 2026-10-12） -->
          <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
              Grid.Column="0"
              Height="64"
              Margin="0"
              HorizontalAlignment="Stretch"
              Appearance="Primary"
              AutomationProperties.Name="{Binding ViewModel.StartStopText, Mode=OneWay}"
              Command="{Binding ViewModel.StartOrStopCommand}"
            >
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:SymbolIcon
                  VerticalAlignment="Center"
                  FontSize="20"
                  Symbol="{Binding ViewModel.StartStopSymbol, Mode=OneWay}"
                />
                <TextBlock
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Text="{Binding ViewModel.StartStopText, Mode=OneWay}"
                />
              </StackPanel>
            </ui:Button>

            <!--
              运行指示动画（用户 2026-10-13）：夹在「启动试验」与「有效性计算」中间，
              试验过程中转起来、停止时停住（开关在 code-behind 里按 IsRunning 控制）。
            -->
            <!-- 等高的指示框（64 = 两侧按钮高度），左右各留 16 的等距间隙 -->
            <Border
              Grid.Column="1"
              Width="60"
              Height="64"
              Margin="16,0"
              VerticalAlignment="Center"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              ToolTip="{Binding ViewModel.RunningHintText, Mode=OneWay}"
            >
              <ui:SymbolIcon
                x:Name="RunningSpinner"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding ViewModel.RunningHintText, Mode=OneWay}"
                FontSize="28"
                Foreground="{Binding ViewModel.RunningBrush, Mode=OneWay}"
                RenderTransformOrigin="0.5,0.5"
                Symbol="ArrowSync24"
              >
                <ui:SymbolIcon.RenderTransform>
                  <RotateTransform x:Name="RunningSpinnerRotate" />
                </ui:SymbolIcon.RenderTransform>
              </ui:SymbolIcon>
            </Border>

            <ui:Button
              Grid.Column="2"
              MinWidth="120"
              Height="64"
              Appearance="Primary"
              Command="{Binding ViewModel.EvaluateValidityCommand}"
              Content="{DynamicResource Exec.Validity}"
              Icon="{ui:SymbolIcon CheckmarkCircle24}"
            />
          </Grid>

          <!--
            试样信息列表：只显示**本试验单**的试样（用户 2026-10-13）。
            列由 code-behind 按方法声明的试样信息字段生成（方法不同字段不同），所以这里不开自动生成。
          -->
          <DataGrid
            x:Name="SampleGrid"
            Grid.Row="2"
            Margin="0,12,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding ViewModel.SampleRows}"
            SelectedItem="{Binding ViewModel.SelectedSample, Mode=TwoWay}"
            SelectionMode="Single"
          />
        </Grid>
      </ui:Card>

      <ui:Card Grid.Column="1" Margin="0,0,8,0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <sp:WpfPlot x:Name="RealtimePlot" MinHeight="240" VerticalAlignment="Stretch" />
      </ui:Card>

      <ui:Card Grid.Column="2" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource FieldLabelStyle}"
            Text="{Binding ViewModel.PhaseText, Mode=OneWay}"
          />
          <ui:Button
            DockPanel.Dock="Bottom"
            Margin="0,8,0,0"
            Appearance="Primary"
            Command="{Binding ViewModel.ClearLogCommand}"
            Content="{DynamicResource Exec.ClearInfo}"
            Icon="{ui:SymbolIcon Broom24}"
          />
          <!--
            DockPanel 的填充项：它会自动占满"就绪"那行下面到"清空信息"按钮上面那块。
            唯一的前提是**本页高度得是有限的** —— 内容宿主按无限高度量内容时，这块"可用空间"
            本身也是无限的，列表就会随条目无限长高、把整页撑高（实测 300 条时页面 739 → 12380）。
            页面高度在 code-behind 里被限制到宿主可见区（见 UpdatePageHeight），
            所以这里不需要再给列表设高度上限：它铺满中间的可见空间，超出部分自己滚动。
          -->
          <ListBox
            Margin="0,8,0,0"
            FontFamily="Consolas, Courier New"
            FontSize="12"
            ItemsSource="{Binding ViewModel.Log}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
          >
            <!--
              操控信息里的行经常比这一栏宽（用户 2026-10-14：信息被截断，想要悬停看全文）。
              默认渲染是**直接裁掉**、看不出被截断；这里显式给模板：
              超长时显示省略号（提示"还有内容"）+ 悬停弹出全文（ToolTip 绑自身文本）。
              注：短行也会弹一个等长的提示 —— WPF 里"只在真被截断时才弹"需要自写
              attached property 去量文本宽度，属可选优化（见知识库）。
            -->
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding}"
                />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </ui:Card>
    </Grid>

    <!-- ④ 底部状态栏：左边连接状态，右侧数据流按钮 -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Exec.Connection}" />
        <TextBlock
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Foreground="{Binding ViewModel.ConnectionBrush, Mode=OneWay}"
          Style="{StaticResource MonoTextStyle}"
          Text="{Binding ViewModel.ConnectionText, Mode=OneWay}"
        />
      </StackPanel>

      <ui:Button
        HorizontalAlignment="Right"
        Appearance="Primary"
        Content="{DynamicResource Exec.DataFlow}"
        Icon="{ui:SymbolIcon DataTrending24}"
        IsEnabled="False"
        ToolTip="{DynamicResource Exec.ToDo}"
      />
    </Grid>
  </Grid>
</Page>
