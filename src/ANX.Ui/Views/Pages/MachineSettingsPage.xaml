<Page
  x:Class="ANX.Ui.Views.Pages.MachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ANX.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Machine"
  d:DataContext="{d:DesignInstance local:MachineSettingsPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="{Binding ViewModel.Title}" />

    <ui:Card
      Grid.Row="1"
      Width="620"
      Margin="0,16,0,0"
      Padding="20"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      VerticalContentAlignment="Top"
    >
      <ItemsControl ItemsSource="{Binding ViewModel.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding DisplayName}" />
              <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                Style="{StaticResource FieldLabelStyle}"
                Text="{Binding Unit}"
              />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ui:Card>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
      <ui:Button
        Width="110"
        Appearance="Primary"
        Command="{Binding ViewModel.SaveCommand}"
        Content="{DynamicResource Param.Save}"
      />
      <ui:Button
        Width="110"
        Margin="8,0,0,0"
        Appearance="Secondary"
        Command="{Binding ViewModel.ReloadCommand}"
        Content="{DynamicResource Param.Reload}"
      />
    </StackPanel>

    <TextBlock
      Grid.Row="3"
      Margin="0,10,0,0"
      Style="{StaticResource MonoTextStyle}"
      Text="{Binding ViewModel.Status, Mode=OneWay}"
    />
  </Grid>
</Page>
