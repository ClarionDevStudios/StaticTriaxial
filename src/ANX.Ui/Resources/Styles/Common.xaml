<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:ANX.Ui.Converters"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <!-- 日期字段：界面用日期选择器，值是 `yyyy-MM-dd` 文本 -->
  <conv:DateTextConverter x:Key="DateText" />

  <!-- true→可见，false→占位但不可见（用于让一行保留空间） -->
  <conv:BoolToHiddenVisibilityConverter x:Key="HiddenWhenFalse" />

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="DemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="MonoTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Consolas, Courier New" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!--
    页面底部那条状态行（ViewModel.Status）：**出错时红字 + 每秒闪一次**（用户 2026-10-14）。
    "是不是错误"由 ViewModel 的 StatusIsError 说（ViewModelBase.SetStatus 统一维护），界面不猜文案。
    闪烁用 Opacity 动画：0.5s 变淡 + 0.5s 回实 = 每秒一次；ExitActions 里 StopStoryboard
    **把动画摘掉**（不是暂停），透明度自然回到 1。
  -->
  <Style x:Key="StatusTextStyle" BasedOn="{StaticResource MonoTextStyle}" TargetType="TextBlock">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ViewModel.StatusIsError}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="StatusBlinkStoryboard">
            <Storyboard>
              <DoubleAnimation
                AutoReverse="True"
                Duration="0:0:0.5"
                From="1"
                RepeatBehavior="Forever"
                Storyboard.TargetProperty="Opacity"
                To="0.15"
              />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="StatusBlinkStoryboard" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 参数配置类页面的分区小标题与行内校验文案 -->
  <Style x:Key="ParamSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="ParamErrorTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>

  <!-- 参数说明（名称下方一句话，照现役窗体里每项的注释） -->
  <Style x:Key="ParamDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- 待接线标记（现役有、本软件还没功能的项） -->
  <Style x:Key="ParamPendingBadgeStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
  </Style>

  <!--
    参数行：显示名 | 编辑控件 | 单位与范围提示 | 行内校验文案。
    数字/文本用文本框、开关用复选框，两者按 IsSwitch 互斥显示（不用 BasedOn，保住 WPF-UI 的隐式样式）。
  -->
  <DataTemplate x:Key="ParameterRowTemplate">
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <!-- 编辑列按控件自适应：通道下拉的选项文字比数字框宽（"千分表3+4通道平均值"） -->
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 名称（用户 2026-10-12：取消各项参数的说明，不再显示第二行小字） -->
      <TextBlock
        Grid.Column="0"
        Margin="0,0,12,0"
        Style="{StaticResource FieldLabelStyle}"
        Text="{Binding DisplayName}"
        TextWrapping="Wrap"
      />

      <TextBox
        Grid.Column="1"
        Width="150"
        IsEnabled="{Binding IsEditable}"
        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
        Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVisibility}}"
      />

      <CheckBox
        Grid.Column="1"
        VerticalAlignment="Center"
        IsEnabled="{Binding IsEditable}"
        IsChecked="{Binding SwitchValue}"
        Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVisibility}}"
      />

      <!-- 通道号这类固定选项：下拉列表（现役用单选组，改下拉省空间） -->
      <ComboBox
        Grid.Column="1"
        MinWidth="200"
        IsEnabled="{Binding IsEditable}"
        DisplayMemberPath="Label"
        ItemsSource="{Binding Options}"
        SelectedValue="{Binding Value, Mode=TwoWay}"
        SelectedValuePath="Value"
        Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
      />

      <TextBlock
        Grid.Column="2"
        Margin="10,0,0,0"
        Style="{StaticResource FieldLabelStyle}"
        Text="{Binding Hint}"
      />

      <TextBlock
        Grid.Column="3"
        Style="{StaticResource ParamPendingBadgeStyle}"
        Text="{DynamicResource Param.PendingIntegration}"
        Visibility="{Binding PendingIntegration, Converter={StaticResource BoolToVisibility}}"
      />

      <TextBlock
        Grid.Column="3"
        Margin="10,0,0,0"
        Style="{StaticResource ParamErrorTextStyle}"
        Text="{Binding ErrorText}"
      />
    </Grid>
  </DataTemplate>

  <!-- 一个作用时点分区：标题 + 说明 + 该组的参数行 -->
  <DataTemplate x:Key="ParameterGroupTemplate">
    <ui:Card
      Width="620"
      Margin="0,0,0,14"
      Padding="20"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      VerticalContentAlignment="Top"
    >
      <StackPanel>
        <TextBlock Style="{StaticResource ParamSectionTitleStyle}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding Hint}" />
        <ItemsControl
          Margin="0,14,0,0"
          ItemTemplate="{StaticResource ParameterRowTemplate}"
          ItemsSource="{Binding Rows}"
        />
      </StackPanel>
    </ui:Card>
  </DataTemplate>
</ResourceDictionary>
