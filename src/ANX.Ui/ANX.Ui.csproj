<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ANX.Core\ANX.Core.csproj" />
    <ProjectReference Include="..\ANX.Control\ANX.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      窗口图标用 PNG（64×64）：WPF 把 .ico 当 Resource 打包时在运行期会报"找不到资源"（实测），
      所以 .ico 只留给 exe 图标（Host 的 ApplicationIcon），窗口这里用同款形状的 PNG。
    -->
    <Resource Include="Assets\anx-icon.png" />
    <Resource Include="Assets\anx.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
</Project>
