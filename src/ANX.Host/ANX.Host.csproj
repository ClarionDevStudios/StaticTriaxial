<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ANX.Host</RootNamespace>
    <AssemblyName>ANX.Host</AssemblyName>
    <!-- exe（资源管理器 / 任务栏）图标：与窗口图标共用 ANX.Ui 里那一份 .ico -->
    <ApplicationIcon>..\ANX.Ui\Assets\anx.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ANX.Core\ANX.Core.csproj" />
    <ProjectReference Include="..\ANX.Ui\ANX.Ui.csproj" />
    <ProjectReference Include="..\ANX.Control\ANX.Control.csproj" />
    <ProjectReference Include="..\ANX.Storage\ANX.Storage.csproj" />
    <ProjectReference Include="..\ANX.Communication\ANX.Communication.csproj" />
    <ProjectReference Include="..\ANX.Protocol\ANX.Protocol.csproj" />
    <ProjectReference Include="..\..\methods\ANX.Method.Bending\ANX.Method.Bending.csproj" />
    <!-- 铁律：全解决方案只有本工程引用 methods\ 下的方法工程（M3 起） -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>
</Project>
