<ui:FluentWindow
  x:Class="STS.Ui.Views.Dialogs.PageDialogWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="STS"
  Icon="pack://application:,,,/STS.Ui;component/Assets/sts-icon.png"
  ExtendsContentIntoTitleBar="True"
  FontFamily="Microsoft YaHei UI, Segoe UI"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--
      标题栏只留"拖动 + 关闭"：不显示标题文字、不给最大化/最小化。
      弹窗里要显示的标题由页面自己那一行大标题负责 —— 两边都写就是同一句话出现两次。
    -->
    <ui:TitleBar Grid.Row="0" ShowClose="True" ShowMaximize="False" ShowMinimize="False" />

    <!--
      页面装在里；构造函数里由 ModalPageService 塞进来。
      **必须是 Frame（或直接挂在 Window 上）**：WPF 的 Page 只允许 Window / Frame 当父级，
      放进普通 ContentPresenter 会在运行期抛 "Page 只能具有 Window 或 Frame 父级"。
      Frame 自带的导航条与灰底都去掉 —— 这里只借它的"能装 Page"。
    -->
    <Frame
      x:Name="Body"
      Grid.Row="1"
      Background="Transparent"
      Focusable="False"
      NavigationUIVisibility="Hidden"
    />
  </Grid>
</ui:FluentWindow>
