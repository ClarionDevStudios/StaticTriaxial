<Page
  x:Class="STS.Ui.Views.Pages.SampleEditorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:STS.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Sample"
  d:DataContext="{d:DesignInstance local:SampleEditorPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="{Binding ViewModel.Title}" />

    <!-- 说明 + 工具条（与参数配置页同构：说明生效时点、保存 / 重新载入 / 恢复默认） -->
    <StackPanel Grid.Row="1" Margin="0,6,0,0">
      <TextBlock
        MaxWidth="980"
        HorizontalAlignment="Left"
        Style="{StaticResource PageSubtitleStyle}"
        Text="{Binding ViewModel.Description}"
      />

      <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
        <ui:Button
          Width="110"
          Appearance="Primary"
          Command="{Binding ViewModel.SaveCommand}"
          Content="{DynamicResource Param.Save}"
        />
        <ui:Button
          Width="110"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.ReloadCommand}"
          Content="{DynamicResource Param.Reload}"
        />
        <ui:Button
          Width="130"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.RestoreDefaultsCommand}"
          Content="{DynamicResource Param.RestoreDefaults}"
        />
        <!-- 用户 2026-10-13 起本页是弹出窗体：靠导航栏离开的路没了，给一个明确的关闭 -->
        <ui:Button
          Width="110"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.CloseCommand}"
          Content="{DynamicResource Common.Close}"
        />
        <TextBlock
          Margin="14,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource FieldLabelStyle}"
          Text="{DynamicResource Param.UnsavedChanges}"
          Visibility="{Binding ViewModel.HasChanges, Converter={StaticResource BoolToVisibility}}"
        />
        <!-- 状态贴近工具条：页面宿给的是无限高度，放在页尾会被窗口裁掉 -->
        <TextBlock
          Margin="14,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource StatusTextStyle}"
          Text="{Binding ViewModel.Status, Mode=OneWay}"
        />
      </StackPanel>
    </StackPanel>

    <!-- 这一件是谁 + 它的信息字段（与参数页共用行模板） -->
    <ui:Card
      Grid.Row="2"
      MaxWidth="980"
      Margin="0,16,0,0"
      Padding="20"
      HorizontalAlignment="Left"
      VerticalContentAlignment="Top"
    >
      <StackPanel>
        <TextBlock Style="{StaticResource ParamSectionTitleStyle}" Text="{DynamicResource Sample.Fields}" />

        <Grid Margin="0,14,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            Margin="0,0,12,0"
            Style="{StaticResource FieldLabelStyle}"
            Text="{DynamicResource Sample.SampleId}"
          />
          <TextBox Grid.Column="1" Text="{Binding ViewModel.SampleId, UpdateSourceTrigger=LostFocus}" />
          <TextBlock
            Grid.Column="2"
            Margin="10,0,0,0"
            Style="{StaticResource FieldLabelStyle}"
            Text="{Binding ViewModel.SheetId}"
          />
        </Grid>

        <ItemsControl
          ItemTemplate="{StaticResource ParameterRowTemplate}"
          ItemsSource="{Binding ViewModel.Rows}"
        />
      </StackPanel>
    </ui:Card>
  </Grid>
</Page>
