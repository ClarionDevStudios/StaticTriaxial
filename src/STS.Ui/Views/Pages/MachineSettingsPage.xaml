<Page
  x:Class="STS.Ui.Views.Pages.MachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:STS.Ui.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{DynamicResource Nav.MachineSettings}"
  d:DataContext="{d:DesignInstance local:MachineSettingsPage, IsDesignTimeCreatable=False}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource PageTitleStyle}" Text="{Binding ViewModel.Title}" />

    <!-- 说明 + 工具条：这页参数在哪些时点生效、以及保存 / 重新载入 / 恢复默认 -->
    <StackPanel Grid.Row="1" Margin="0,6,0,0">
      <TextBlock
        MaxWidth="980"
        HorizontalAlignment="Left"
        Style="{StaticResource PageSubtitleStyle}"
        Text="{Binding ViewModel.Description}"
      />

      <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
        <ui:Button
          Width="110"
          Appearance="Primary"
          Command="{Binding ViewModel.SaveCommand}"
          Content="{DynamicResource Param.Save}"
        />
        <ui:Button
          Width="110"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.ReloadCommand}"
          Content="{DynamicResource Param.Reload}"
        />
        <ui:Button
          Width="130"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.RestoreDefaultsCommand}"
          Content="{DynamicResource Param.RestoreDefaults}"
        />
        <TextBlock
          Margin="14,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource FieldLabelStyle}"
          Text="{DynamicResource Param.UnsavedChanges}"
          Visibility="{Binding ViewModel.HasChanges, Converter={StaticResource BoolToVisibility}}"
        />
        <!-- 状态贴近工具条：页面宿给的是无限高度，放在页尾会被窗口裁掉 -->
        <TextBlock
          Margin="14,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource StatusTextStyle}"
          Text="{Binding ViewModel.Status, Mode=OneWay}"
        />
      </StackPanel>
    </StackPanel>

    <!-- 页签条（比照现役配置窗体的 PageControl）：通道设置 / 试验参数 -->
    <ItemsControl
      Grid.Row="2"
      Margin="0,16,0,0"
      HorizontalAlignment="Left"
      ItemsSource="{Binding ViewModel.Tabs}"
    >
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ui:Button
            MinWidth="120"
            Margin="0,0,8,0"
            Command="{Binding DataContext.ViewModel.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Page}}"
            CommandParameter="{Binding}"
            Content="{Binding Title}"
          >
            <ui:Button.Style>
              <Style TargetType="ui:Button">
                <Setter Property="Appearance" Value="Secondary" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
          </ui:Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 当前页签的内容（每区一张卡） -->
    <ItemsControl
      Grid.Row="3"
      Margin="0,14,0,0"
      HorizontalAlignment="Left"
      ItemTemplate="{StaticResource ParameterGroupTemplate}"
      ItemsSource="{Binding ViewModel.SelectedTab.Groups}"
    >
      <!-- 卡片横向排布：运行期在左、计算期在右（窗口窄时自动换行） -->
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>
</Page>
