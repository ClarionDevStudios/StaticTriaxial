<!--
  离线还原：只用本机 NuGet 全局缓存作为包源。
  需要联网拉新包时，把 <clear /> 去掉并加回 nuget.org。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="C:\Users\ChenJie\.nuget\packages" />
    <!-- 公司采购的 TMS FlexCel 零售包（本机目录），放本地源里供离线还原 -->
    <add key="tms-flexcel" value="F:\Setup\DevFolder\VisualStudio\3rdParties\TMS FlexCel Studio for .NET v7.26.0 (04 Apr 2026) ALL PLATFORMS + Nuget Packages Retail\nuget" />
  </packageSources>
</configuration>
